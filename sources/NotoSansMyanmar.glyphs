code = "
lookup RaWidth3 {
    sub medial_ra by medial_ra.w3;
    sub medial_ra_wa by medial_ra_wa.w3;
    sub medial_ra_wa_ha by medial_ra_wa_ha.w3;
    sub medial_ra_wa_ovl by medial_ra_wa_ovl.w3;
    sub medial_ra_wa_ha_ovl by medial_ra_wa_ha_ovl.w3;
} RaWidth3;

lookup RaWidth2_5 {
    sub medial_ra by medial_ra.w2_5;
    sub medial_ra_wa by medial_ra_wa.w2_5;
    sub medial_ra_wa_ha by medial_ra_wa_ha.w2_5;
    sub medial_ra_wa_ovl by medial_ra_wa_ovl.w2_5;
    sub medial_ra_wa_ha_ovl by medial_ra_wa_ha_ovl.w2_5;
} RaWidth2_5;

lookup RaWidth2 {
    sub medial_ra by medial_ra.w2;
    sub medial_ra_wa by medial_ra_wa.w2;
    sub medial_ra_wa_ha by medial_ra_wa_ha.w2;
    sub medial_ra_wa_ovl by medial_ra_wa_ovl.w2;
    sub medial_ra_wa_ha_ovl by medial_ra_wa_ha_ovl.w2;
} RaWidth2;

lookup RaWidth1_5 {
    sub medial_ra by medial_ra.w1_5;
    sub medial_ra_wa by medial_ra_wa.w1_5;
    sub medial_ra_wa_ha by medial_ra_wa_ha.w1_5;
    sub medial_ra_wa_ovl by medial_ra_wa_ovl.w1_5;
    sub medial_ra_wa_ha_ovl by medial_ra_wa_ha_ovl.w1_5;
} RaWidth1_5;
";
name = "Medial Ra width";
},
{
code = "
lookup RaTopTrimming {
    lookupflag 0;
    ;
    # Original source: 46 
    sub medial_ra by medial_ra_tt;
    sub medial_ra_wa by medial_ra_wa_tt;
    sub medial_ra_wa.w2 by medial_ra_wa_tt.w2;
    sub medial_ra.w2 by medial_ra_tt.w2;
    sub medial_ra_wa_ha by medial_ra_wa_ha_tt;
    sub medial_ra_wa_ha.w2 by medial_ra_wa_ha_tt.w2;
    sub medial_ra.w2_5 by medial_ra_tt.w2_5;
    sub medial_ra_wa_ovl by medial_ra_wa_ovl_tt;
    sub medial_ra_wa_ovl.w2 by medial_ra_wa_ovl_tt.w2;
    sub medial_ra_wa_ha_ovl by medial_ra_wa_ha_ovl_tt;
    sub medial_ra_wa_ha_ovl.w2 by medial_ra_wa_ha_ovl_tt.w2;
    sub medial_ra_wa.w2_5 by medial_ra_wa_tt.w2_5;
    sub medial_ra_wa_ovl.w2_5 by medial_ra_wa_ovl_tt.w2_5;
    sub medial_ra_wa_ha_ovl.w2_5 by medial_ra_wa_ha_ovl_tt.w2_5;
    sub medial_ra.w3 by medial_ra_tt.w3;
    sub medial_ra.w1_5 by medial_ra_tt.w1_5;
    sub medial_ra_wa_ha.w2_5 by medial_ra_wa_ha_tt.w2_5;
    sub medial_ra_wa.w3 by medial_ra_wa_tt.w3;
    sub medial_ra_wa_ha.w3 by medial_ra_wa_ha_tt.w3;
    sub medial_ra_wa.w1_5 by medial_ra_wa_tt.w1_5;
    sub medial_ra_wa_ha.w1_5 by medial_ra_wa_ha_tt.w1_5;
    sub medial_ra_wa_ovl.w1_5 by medial_ra_wa_ovl_tt.w1_5;
    sub medial_ra_wa_ha_ovl.w1_5 by medial_ra_wa_ha_ovl_tt.w1_5;
    sub medial_ra_wa_ovl.w3 by medial_ra_wa_ovl_tt.w3;
    sub medial_ra_wa_ha_ovl.w3 by medial_ra_wa_ha_ovl_tt.w3;
} RaTopTrimming;
";
name = "Medial Ra top trimming";
},
{
code = "
lookup RaBottomTrimming {
    lookupflag 0;
    ;
    # Original source: 47 
    sub medial_ra by medial_ra_bt;
    sub medial_ra.w2 by medial_ra_bt.w2;
    sub medial_ra_tt by medial_ra_tt_bt;
    sub medial_ra_tt.w2 by medial_ra_tt_bt.w2;
    sub medial_ra.w2_5 by medial_ra_bt.w2_5;
    sub medial_ra_tt.w2_5 by medial_ra_tt_bt.w2_5;
    sub medial_ra.w3 by medial_ra_bt.w3;
    sub medial_ra_tt.w3 by medial_ra_tt_bt.w3;
    sub medial_ra.w1_5 by medial_ra_bt.w1_5;
    sub medial_ra_tt.w1_5 by medial_ra_tt_bt.w1_5;
} RaBottomTrimming;

lookup SingleSubstitution50 {
    lookupflag 0;
    ;
    # Original source: 49 
    sub medial_ra by medial_ra_bt3;
    sub medial_ra.w2 by medial_ra_bt3.w2;
    sub medial_ra_tt by medial_ra_tt_bt3;
    sub medial_ra_tt.w2 by medial_ra_tt_bt3.w2;
} SingleSubstitution50;

lookup SingleSubstitution49 {
    lookupflag 0;
    ;
    # Original source: 48 
    sub medial_ra.w2 by medial_ra_bt2.w2;
    sub medial_ra_tt.w2 by medial_ra_tt_bt2.w2;
    sub medial_ra.w2_5 by medial_ra_bt2.w2_5;
    sub medial_ra_tt.w2_5 by medial_ra_tt_bt2.w2_5;
    sub medial_ra.w3 by medial_ra_bt2.w3;
    sub medial_ra_tt.w3 by medial_ra_tt_bt2.w3;
    sub medial_ra.w1_5 by medial_ra_bt2.w1_5;
    sub medial_ra_tt.w1_5 by medial_ra_tt_bt2.w1_5;
} SingleSubstitution49;
";
name = "Medial Ra bottom trimming";
