code = "lookup LigatureSubstitution12 {
    lookupflag MarkAttachmentType @belowmarks;
    sub medial_wa medial_ha dot_below by medial_wa_ha_dot;
    sub medial_wa dot_below by medial_wa_dot;
    sub medial_wa medial_ha by medial_wa_ha;
    sub _u dot_below by _u_dot;
    sub _uu dot_below by _uu_dot;
    sub medial_ya medial_wa medial_ha by medial_ya_wa_ha;
    sub medial_ya medial_wa_ovl medial_ha_obl by medial_ya_wa_ha_ovl;
    sub medial_ya medial_ha by medial_ya_ha;
    sub medial_ya medial_ha_obl by medial_ya_ha;
    sub medial_ya medial_wa by medial_ya_wa;
    sub medial_ya medial_wa_ovl by medial_ya_wa_ovl;
    sub medial_wa_ovl medial_ha_obl dot_below by medial_wa_ha_dot_ovl;
    sub medial_wa_ovl dot_below by medial_wa_dot_ovl;
    sub medial_wa_ovl medial_ha_obl by medial_wa_ha_ovl;
    sub medial_ha _u dot_below by medial_ha_u_dot;
    sub medial_ha _uu dot_below by medial_ha_uu_dot;
    sub medial_ha _u by medial_ha_u;
    sub medial_ha _uu by medial_ha_uu;
    sub medial_ha dot_below by medial_ha_dot;
    sub medial_ha_obl _u by medial_ha_obl_u;
    sub medial_ha_obl _u_dot.alt by medial_ha_obl_u_dot;
    sub medial_ha_obl _uu by medial_ha_obl_uu;
    sub medial_ha_obl _uu_dot.alt by medial_ha_obl_uu_dot;
    sub medial_ha_obl dot_below by medial_ha_dot_obl;
} LigatureSubstitution12;

   ";
tag = blwf;
