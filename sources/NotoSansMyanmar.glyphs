lookup AbovemarkLigatures {
    lookupflag MarkAttachmentType @abovemarks;
    sub kinzi _i anusvara by kinzi_i_anusvara;
    sub kinzi _ii anusvara by kinzi_ii_anusvara;
    sub kinzi _ai by kinzi_ai;
    sub kinzi _i by kinzi_i;
    sub kinzi _ii by kinzi_ii;
    sub kinzi _ii_mon by kinzi_ii_mon;
    sub kinzi anusvara by kinzi_anusvara;
    sub kinzi asat by kinzi_asat;
    sub ra_mark _i by ra_i;
    sub ra_mark _ii by ra_ii;
    sub ra_mark asat by ra_asat;
    sub _tall_aa asat by _tall_aa_asat;
    sub _i _ai by _i_ai;
    sub _i anusvara by _i_anusvara;
    sub _ii anusvara by _ii_anusvara;
    sub _ai redup_khm by ai_dup;
    sub asat anusvara by asat_anusvara;
    sub asat redup_khm by asat_dup;
} AbovemarkLigatures;



