features = (
{
code = "            script mym2;
        language KSW;

lookup SgawWaHa {
    lookupflag MarkAttachmentType @belowmarks;
    sub medial_wa by medial_wa_ovl;
    sub medial_ha by medial_ha_obl;
} SgawWaHa;

lookup ContextualGSUB2 {
    lookupflag MarkAttachmentType @belowmarks;
    sub ra dot_below' by dot_below.k;
    sub ra medial_wa_ovl' dot_below' by medial_wa_dot_ovl;
    sub ra medial_ha_obl' dot_below' by medial_ha_dot_obl;
} ContextualGSUB2;


lookup SgawLeftDot {
    lookupflag MarkAttachmentType @belowmarks;
    sub _u dot_below by _u_dot.alt;
    sub _uu dot_below by _uu_dot.alt;
} SgawLeftDot;

script mym2;
language MON;
substitute nnya virama nnya by greatNnya-mon;";
tag = locl;
},
{
code = "    sub medial_ra medial_wa by medial_ra_wa;
    sub medial_ra medial_wa_ha by medial_ra_wa_ha;
    sub medial_ra medial_wa_ha_ovl by medial_ra_wa_ha_ovl;
    sub medial_ra medial_wa_ovl by medial_ra_wa_ovl;
	sub medial_ra.w2 medial_wa by medial_ra_wa.w2;
	sub medial_ra.w2_5 medial_wa by medial_ra_wa.w2_5;
	sub medial_ra' lookup RaTopTrimming medial_ha' lookup SingleSubstitution37 @class583;
	sub medial_ha.sub2 @class583 _u' lookup PostU_UU;	
	sub medial_ra_wa medial_ha by medial_ra_wa_ha;
	sub @spacing _e dot_below' by dot_below_spacing;

# These used to be in MNW, but should apply to everything;
# see https://github.com/googlefonts/noto-fonts/issues/1926
lookup TallAaSwaps1 {
    sub _tall_aa _ai by tall_aa_ai;
    sub _tall_aa anusvara by tall_aa_anusvara;
} TallAaSwaps1;

lookup TallAaSwaps2 {
    sub tall_aa_ai by _ai _tall_aa;
    sub tall_aa_anusvara by anusvara _tall_aa;
} TallAaSwaps2;
";
tag = ccmp;
},
{
